<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDF6E3"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Table Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WHEEL POH DETAILS"
            android:textSize="18sp"
            android:layout_marginBottom="8dp"
            android:textStyle="bold"
            android:textColor="#E91E63" />

        <!-- Horizontal ScrollView for Table -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TableLayout
                android:id="@+id/tableLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:stretchColumns="*"
                android:background="#FFFFFF"
                android:layout_marginBottom="16dp" />
        </HorizontalScrollView>

        <!-- Pie Charts Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TYPE OF WHEEL POH"
            android:textSize="18sp"
            android:layout_marginBottom="8dp"
            android:textStyle="bold"
            android:textColor="#E91E63" />

        <com.github.mikephil.charting.charts.PieChart
            android:id="@+id/type_of_wheel_chart"
            android:layout_width="match_parent"
            android:layout_height="400dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TYPE OF BEARING"
            android:textSize="18sp"
            android:layout_marginBottom="8dp"
            android:textStyle="bold"
            android:textColor="#E91E63" />

        <com.github.mikephil.charting.charts.PieChart
            android:id="@+id/type_of_bearing_chart"
            android:layout_width="match_parent"
            android:layout_height="400dp"
            android:layout_marginBottom="16dp" />
    </LinearLayout>
</ScrollView>
