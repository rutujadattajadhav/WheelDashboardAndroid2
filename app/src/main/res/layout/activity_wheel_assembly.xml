<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Comprehensive Wheel Assembly Database"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="16dp"
            android:textColor="#E91E63" />

        <!-- Summary Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TOTAL WHEEL\n994"
                android:gravity="center"
                android:padding="8dp"
                android:background="#FFA500"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <Spinner
                android:id="@+id/wheel_set_no_dropdown"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:entries="@array/wheel_set_no_options"
                android:spinnerMode="dropdown" />

            <Spinner
                android:id="@+id/date_range_dropdown"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:entries="@array/date_range_options"
                android:spinnerMode="dropdown" />
        </LinearLayout>

        <!-- Charts Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="16dp">

            <com.github.mikephil.charting.charts.PieChart
                android:id="@+id/wheel_assembly_type_chart"
                android:layout_width="0dp"
                android:layout_height="400dp"
                android:layout_weight="1"
                android:layout_margin="8dp" />

            <com.github.mikephil.charting.charts.BarChart
                android:id="@+id/yearly_wheel_assembly_chart"
                android:layout_width="0dp"
                android:layout_height="400dp"
                android:layout_weight="1"
                android:layout_margin="8dp" />
        </LinearLayout>

        <!-- Table Section -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TableLayout
                android:id="@+id/tableLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:stretchColumns="*"
                android:background="#FFFFFF"
                android:layout_marginBottom="16dp" />
        </HorizontalScrollView>
    </LinearLayout>
</ScrollView>
